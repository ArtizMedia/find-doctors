# CuraLink Doctor Appointment Booking System Environment Configuration

# Server Port (default 3000)
PORT=3000

# Base API URL (used by client API clients)
VITE_API_BASE_URL="/api/v1"

# JWT Secret for session authentication
JWT_SECRET="curalink-super-secret-jwt-key-2026-prod"

# Google Maps Platform (optional - manual address lookup & distance fallback included)
# VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Timezone (Default for Kerala deployment: Asia/Kolkata)
DEFAULT_TIMEZONE="Asia/Kolkata"

# Firebase Config (Optional for cloud deployment)
# VITE_FIREBASE_API_KEY="your-api-key"
# VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
# VITE_FIREBASE_APP_ID="your-app-id"
